{
  "name": "dqc-dashboard",
  "version": "5.0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "npmrc": "./npmsetup.sh",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate --schema=./node_modules/@the-data-quality-co-op/dqc-schema/prisma/schema.prisma",
    "lint": "eslint --max-warnings 0 --cache --cache-location .eslintcache .",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check --log-level warn ./src",
    "format:write": "prettier --write ./src",
    "start": "next start",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:show:report": "pnpm exec playwright show-report",
    "test:e2e:setup": "pnpm exec playwright test tests/__checks__/auth.setup.ts",
    "test:e2e:projects": "pnpm exec playwright test tests/__checks__/e2e/projects/",
    "test:e2e:auth": "pnpm exec playwright test tests/__checks__/e2e/auth/",
    "checkly:test": "pnpm exec checkly test",
    "checkly:test:headless": "pnpm exec checkly test --reporter=dot",
    "checkly:deploy": "pnpm exec checkly deploy",
    "checkly:test:ci": "pnpm exec checkly test --reporter=json",
    "version:sprint": "./scripts/version.sh sprint",
    "version:major": "./scripts/version.sh major",
    "version:minor": "./scripts/version.sh minor",
    "version:patch": "./scripts/version.sh patch",
    "version:check": "node -p \"require('./package.json').version\""
  },
